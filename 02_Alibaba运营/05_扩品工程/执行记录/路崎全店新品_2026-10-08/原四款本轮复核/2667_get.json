      "product_faq": [
        {
          "question": "How do I specify the lining and sizes?",
          "answer": "Regular mesh-textured and fleece-textured lining options are shown, both Black. There is one Black color option and no separate online lining selector. Tell us your lining version and size mix before ordering. Confirmed EU size labels are 39-48; confirm the size chart, with US sizing not inferred from the EU labels."
        },
        {
          "question": "Do the listed prices apply to both lining versions?",
          "answer": "Listed prices are references and do not confirm the same price for both lining versions. We confirm the final quotation for your requested lining version, size mix, quantity, packaging and destination before proceeding. Freight, applicable taxes and additional services are confirmed separately."
        },
        {
          "question": "Which specifications should be confirmed before an order?",
          "answer": "Confirm the requested style, material specifications, color and size mix, quantity, packaging and any sample requirements. Product-specific details and availability are checked before the order is confirmed."
        },
        {
          "question": "Can I enquire about samples and custom branding?",
          "answer": "Send your color, size, logo artwork and packaging brief. Sample availability, customization feasibility, costs and timing are reviewed for this style before confirmation."
        },
        {
          "question": "When will the order be dispatched?",
          "answer": "Dispatch depends on availability, order quantity, size mix and packing requirements. Timing is confirmed for each order before proceeding."
        }
