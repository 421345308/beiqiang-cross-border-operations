        "product_faq": [
          {
            "question": "Which color and EU size combinations are listed?",
            "answer": "Floating Gold: EU 35–45; Plant Grey: EU 35–45; Spring Green: EU 35–45; Cool White: EU 35–45."
          },
          {
            "question": "What should I check during a sample fitting?",
            "answer": "Try the sample with the intended socks. Adjust the laces, then check toe room, instep fit and heel hold before deciding the bulk EU size mix."
          },
          {
            "question": "What is the minimum order for the original style?",
            "answer": "The listed original-style wholesale minimum is 2 pairs. Quantity pricing is shown on this page; branding and custom packaging are quoted separately."
          },
          {
            "question": "How can I request a sample?",
            "answer": "Send the selected color or lining variant, EU size and delivery postcode for a sample quotation. It sets out the sample charge, courier cost and proposed dispatch date."
          },
          {
            "question": "What should I send for a branding or packaging proposal?",
            "answer": "Send your logo artwork, preferred placement, packaging brief and order quantity. We can review the proposal for this style and set out the applicable minimum, cost and sample process."
          },
          {
            "question": "How can I get a delivered quotation?",
            "answer": "Send pair quantities by color and EU size, the destination postcode or port and your packaging request. The quotation separates product cost from freight and includes the proposed dispatch and transit schedule."
          },
          {
            "question": "Which colors can I choose?",
            "answer": "Floating Gold, Plant Grey, Spring Green and Cool White. Use the corresponding color photo and EU size when specifying each quantity."
          }
        ],
