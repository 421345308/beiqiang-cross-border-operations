      "product_faq": [
        {
          "question": "Which colors are listed?",
          "answer": "Khaki and Coffee, each shown in its corresponding real product photo. Send the quantity required for each color and size."
        },
        {
          "question": "Which sizes are listed?",
          "answer": "The listed options are EU sizes 35-41. Share your size chart and quantity per size for order specification confirmation."
        },
        {
          "question": "What materials are used?",
          "answer": "Cowhide leather upper, genuine leather lining, rubber midsole and rubber outsole. Send any additional material specifications with your enquiry."
        },
        {
          "question": "What is the minimum order quantity?",
          "answer": "The listing MOQ is 2 pairs. Send your requested color and size mix for a quotation."
        },
        {
          "question": "How are the quantity prices arranged?",
          "answer": "USD 29.00 per pair for 2-49 pairs, USD 28.20 per pair for 50-99 pairs, and USD 27.30 per pair for 100 pairs or more. Final order terms are confirmed before order placement."
        },
        {
          "question": "What information is needed for a quotation?",
          "answer": "Send your total quantity, size breakdown, destination and packing requirements. Final quotation terms are reviewed for your order."
        },
        {
          "question": "Can I request a sample or customization?",
          "answer": "Send the requested size, destination, logo artwork and quantity so availability and options can be reviewed before an order is arranged."
        },
        {
          "question": "How are packaging and delivery confirmed?",
          "answer": "Share your packing requirements, destination and target delivery date. Actual package measurements, availability and timing are confirmed when reviewing the order."
        }
