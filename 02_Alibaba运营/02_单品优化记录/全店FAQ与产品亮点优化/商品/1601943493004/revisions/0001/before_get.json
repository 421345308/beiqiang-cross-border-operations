      "product_faq": [
        {
          "question": "What materials are used?",
          "answer": "The upper is cowhide leather, the lining is genuine leather, and both the midsole and outsole are rubber."
        },
        {
          "question": "Which color is shown?",
          "answer": "This listing offers the Black color shown in the product photographs."
        },
        {
          "question": "Which EU sizes are listed?",
          "answer": "EU 39, 40, 41, 42, 43 and 44. Share your required size ratio with the enquiry."
        },
        {
          "question": "What is the minimum order?",
          "answer": "The listed minimum order is 2 pairs. Tell us the quantity and EU size mix for quotation."
        },
        {
          "question": "Can I discuss customization?",
          "answer": "Send your logo, color, label or packaging requirements. Availability, feasibility, cost and timing are reviewed before a specific offer is confirmed."
        },
        {
          "question": "Can I request a sample?",
          "answer": "Send the required EU size and destination so we can confirm sample availability, price and shipping arrangements before payment."
        },
        {
          "question": "How is packing confirmed?",
          "answer": "Share your shoe box, label and carton requirements. Final packing and delivery arrangements are confirmed with the order quotation."
        },
        {
          "question": "What is the listed price?",
          "answer": "The listed FOB price tiers are USD 34.50 per pair for 2–49 pairs, USD 33.50 for 50–99 pairs, and USD 32.50 for 100+ pairs. Share the quantity, EU size mix and packing needs for a current quotation."
        }
