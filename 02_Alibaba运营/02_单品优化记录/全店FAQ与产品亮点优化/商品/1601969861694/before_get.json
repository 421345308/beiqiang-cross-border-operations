      "product_faq": [
        {
          "question": "What materials are confirmed?",
          "answer": "The current source attributes confirm an EVA upper. Separate lining, midsole and ground-contact outsole compositions are not specified. Send any layer-specific material requirements for confirmation before order."
        },
        {
          "question": "Which colours and sizes can I request?",
          "answer": "Black, Grey and Khaki. The source uses paired size labels 36-37, 38-39, 40-41, 42-43 and 44-45; these remain five choices, not ten separate sizes. Send fit requirements for confirmation."
        },
        {
          "question": "What is the minimum order and reference price?",
          "answer": "The minimum order is 2 pairs. Reference prices are USD 3.36 for 2-49 pairs, USD 3.14 for 50-99 pairs and USD 2.92 for 100 pairs or more. Freight and final order terms are confirmed separately."
        },
        {
          "question": "How do I confirm the assortment?",
          "answer": "Share quantities for each colour and paired size label. Current availability, agreed fit measurements and packing requirements are confirmed for your order."
        },
        {
          "question": "Can I request samples or custom packaging?",
          "answer": "Send your sample quantity, packaging and branding requirements. Feasibility, charges, minimum quantities and timing are assessed before quotation."
        },
        {
          "question": "How are dispatch and delivery arranged?",
          "answer": "Send the destination, quantities and required date. Packing, freight options and dispatch timing are confirmed against the agreed order."
        }
