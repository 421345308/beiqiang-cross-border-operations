      "product_faq": [
        {
          "question": "Are you a factory or a trading company?",
          "answer": "We are a footwear factory supplier located in Quanzhou, Fujian, China, serving overseas B2B buyers."
        },
        {
          "question": "What is your MOQ?",
          "answer": "The current store baseline starts from 2 pairs. The applicable quantity, price and production arrangement are confirmed according to the selected style and order requirements."
        },
        {
          "question": "Can I mix different colors and sizes in one order?",
          "answer": "Mixed colors and sizes can be discussed, subject to current availability, size ratio and production confirmation."
        },
        {
          "question": "Can I order samples before bulk order?",
          "answer": "Samples can be discussed for quality checking. Sample price, courier charge and preparation time are quoted separately for the selected style before payment."
        },
        {
          "question": "Do you support customized packaging?",
          "answer": "The current single-pair package baseline is 34 x 23 x 13 cm and approximately 0.5 kg. Order-specific packing is confirmed before shipment."
        },
        {
          "question": "Do you support logo or product customization?",
          "answer": "Logo, color, size ratio and packaging requirements can be discussed. Please provide your design and target quantity for production review."
        },
        {
          "question": "How long is the delivery time?",
          "answer": "The current store baseline is 31 days for 100 pairs. Final lead time depends on style, quantity, materials and customization requirements and is confirmed before order."
        },
        {
          "question": "Why choose your factory?",
          "answer": "This regular-fit knit/textile slip-on style has a distinctive biscuit-sole appearance for wholesale and OEM/ODM discussions."
        }
      ],
