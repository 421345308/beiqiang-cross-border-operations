      "product_faq": [
        {
          "question": "What materials are used in this sandal?",
          "answer": "The upper is cowhide leather, the lining is cloth, and both the midsole and outsole are TPR."
        },
        {
          "question": "Which colors and sizes are listed?",
          "answer": "Black and Brown are listed in EU sizes 39-46. Please specify the quantity for each color and size."
        },
        {
          "question": "What is the minimum order quantity?",
          "answer": "The listed minimum order quantity is 2 pairs."
        },
        {
          "question": "How do the quantity prices work?",
          "answer": "Listed prices are USD 28.90 per pair for 2-49 pairs, USD 28.10 per pair for 50-99 pairs, and USD 27.30 per pair for 100 pairs or more. Final order terms are confirmed in the quotation."
        },
        {
          "question": "Can I request a sample before ordering?",
          "answer": "Send the required color, EU size and destination so we can confirm sample availability, charges and delivery arrangements before payment."
        },
        {
          "question": "Can the logo or packaging be customized?",
          "answer": "Send your artwork and packing requirements. Feasibility, minimum quantity and any additional charges must be confirmed for this style before ordering."
        },
        {
          "question": "How can I check the fit?",
          "answer": "The listed sizes are EU labels. Please send your fit and measurement requirements so the appropriate size specification can be confirmed before ordering."
        },
        {
          "question": "How are shipping and delivery arranged?",
          "answer": "Send the color-size quantities, destination and packing requirements. Freight, trade terms and delivery arrangements are confirmed in the final quotation."
        }
      ],
