      "product_faq": [
        {
          "question": "Who are we?",
          "answer": "We are a footwear manufacturer located in Quanzhou, Fujian, China, specializing in casual and sport-casual footwear, especially slip-on sneakers and lightweight knit shoes."
        },
        {
          "question": "How can we guarantee quality?",
          "answer": "We focus on quality control through key details like shoe shape, upper workmanship, stitching, bonding, sole flexibility, wearing comfort, appearance consistency and packaging condition. We check products before delivery to reduce quality risks."
        },
        {
          "question": "Are you a trading company or a manufacturer?",
          "answer": "We are a manufacturer."
        },
        {
          "question": "Why should you buy from us not from other suppliers?",
          "answer": "We offer flexible customization, OEM/ODM cooperation, stable quality, competitive prices, and reliable communication. Our products are suitable for daily wear, walking, travel, and online retail, with a focus on comfort and practicality."
        },
        {
          "question": "What services can we provide?",
          "answer": "We provide OEM/ODM cooperation, customization options like upper material, color combination, outsole design, logo placement, label, insole, shoebox, and packaging. We support sample development, bulk production, and long-term supply cooperation."
        }
      ],
