      "product_faq": [
        {
          "question": "What materials are used?",
          "answer": "The upper is canvas, the lining is cotton fabric, the midsole is rubber, and the outsole is plastic."
        },
        {
          "question": "Which colors and sizes are available?",
          "answer": "This style is listed in Blue, Black, White, Red, Grey and Khaki, in EU sizes 39-48. Please confirm the requested color and size mix for the order."
        },
        {
          "question": "What is the minimum order quantity?",
          "answer": "The listing MOQ is 5 pairs. Please confirm the requested color and size mix and availability for the order."
        },
        {
          "question": "How is the quantity price arranged?",
          "answer": "The listed FOB price tiers are USD 8.50 per pair for 5-49 pairs, USD 8.30 per pair for 50-99 pairs, and USD 8.00 per pair for 100+ pairs. Share the quantity, color-size mix and packing needs for a current quotation."
        },
        {
          "question": "Can I choose the size ratio for my order?",
          "answer": "Share the EU size quantity breakdown you need across EU 39-48 so the size ratio can be checked for the order."
        },
        {
          "question": "What is the packing for one pair?",
          "answer": "The listed packing measures 30 x 20 x 10 cm with a gross weight of 1.2 kg per pair. Share any alternative packing requirements for review."
        },
        {
          "question": "What information is needed for an order quotation?",
          "answer": "Please share the color, EU size quantity breakdown, total pairs, destination and packing preference. The final quotation depends on style, quantity, materials, size mix, packing and order requirements."
        },
        {
          "question": "Can I request a sample?",
          "answer": "Please share the requested color, size and destination so sample availability, price and timing can be confirmed for the current enquiry."
