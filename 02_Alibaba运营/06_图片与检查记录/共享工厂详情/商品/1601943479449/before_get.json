      "product_faq": [
        {
          "question": "What style is this shoe?",
          "answer": "Men's slip-on penny loafers with a low-top opening, penny strap and moc-toe stitching."
        },
        {
          "question": "Which colors are listed?",
          "answer": "Black and Blue. Include your required quantity for each color with your enquiry."
        },
        {
          "question": "Which sizes are listed?",
          "answer": "EU sizes 39-46. Send your required size breakdown with your enquiry."
        },
        {
          "question": "What materials are used?",
          "answer": "Leather upper and lining with rubber midsole and outsole. Send any additional material specifications with your enquiry."
        },
        {
          "question": "What is the minimum order quantity?",
          "answer": "The listing MOQ is 2 pairs. Send your color-size quantities for a quotation."
        },
        {
          "question": "How are the prices structured?",
          "answer": "USD 31.70 per pair for 2-49 pairs, USD 30.80 per pair for 50-99 pairs, and USD 29.90 per pair for 100 pairs or more. Final order terms are confirmed before order placement."
        },
        {
          "question": "Can I request customization?",
          "answer": "Send your logo artwork and packing requirements so we can review the options for your order."
        },
        {
          "question": "How is delivery arranged?",
          "answer": "Share your required color-size quantities, destination and target delivery date. Availability and timing are confirmed when reviewing your order."
        }
      ],
