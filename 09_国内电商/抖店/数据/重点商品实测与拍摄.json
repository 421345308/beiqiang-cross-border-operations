    "M889": {
      "name": "针织系带休闲款",
      "sample": "黑白常规、黑白加绒同码；米白加绒单独补拍；不要拿A1689套脚鞋",
      "story": [
        {
          "time": "0—3秒",
          "scene": "鞋面近景",
          "action": "手在鞋带处调整松紧",
          "voice": "脚背这里，想松一点还是紧一点？",
          "text": "系带松紧自己调",
          "check": "本款实际为系带"
        },
        {
          "time": "3—10秒",
          "scene": "侧前方连续镜头",
          "action": "松鞋带、穿入、整理鞋舌和后跟，再系带",
          "voice": "穿好后，按自己的脚背把松紧调到合适。",
          "text": "完整穿鞋过程",
          "check": "不剪成无需系带"
        },
        {
          "time": "10—16秒",
          "scene": "近景",
          "action": "分别展示常规与加绒内里；镜头切到真实后跟绒面",
          "voice": "秋冬选加绒，换季看常规，下单别选错内里。",
          "text": "常规 / 加绒分开选",
          "check": "两版只讲实物差异"
        },
        {
          "time": "16—24秒",
          "scene": "低机位走动与定格",
          "action": "黑白配深色裤、米白配浅色裤，各拍正侧后",
          "voice": "黑白、全黑、米白，先看你平常怎么搭。",
          "text": "配色以所选规格为准",
          "check": "剪辑每次切色标注，不混为单一颜色"
        },
        {
          "time": "24—29秒",
          "scene": "上脚正面",
          "action": "人站定，手指鞋带再给尺码标签特写",
          "voice": "系带能调脚背，尺码仍要先看脚长。",
          "text": "可调松紧≠任意脚型适用",
          "check": "不宣称宽楦或防脚痛"
        }
      ],
      "selection": [
        {
          "time": "0—7秒",
          "scene": "俯拍测量",
          "action": "左右脚长、前掌脚围分别测，记录袜子",
          "voice": "先记脚长和脚围，再看这双的版本。",
          "text": "脚长毫米 / 脚围毫米",
          "check": "别以外底长当内长"
        },
        {
          "time": "7—17秒",
          "scene": "桌面同码对照",
          "action": "常规、加绒分别量鞋垫；米白加绒核标签和结构",
          "voice": "同码分版本量，米白也单独核对鞋楦和标记。",
          "text": "同码两版对照",
          "check": "若不同颜色楦/批次不一致要另测"
        },
        {
          "time": "17—29秒",
          "scene": "脚背近景+侧面",
          "action": "固定同袜，先合理放松鞋带再试穿站立走动",
          "voice": "鞋带松紧会影响感受，先合理调整再判断。",
          "text": "前掌 / 脚背 / 后跟",
          "check": "不勒紧后说显瘦，不故意放松造成掉跟"
        },
        {
          "time": "29—38秒",
          "scene": "标签与表格",
          "action": "填写真实感受及尺码，拍清尺码标签",
          "voice": "把实测结果留下来，客服才能按款建议。",
          "text": "测量结果待填写",
          "check": "未实测不发布偏码结论"
        }
      ],
