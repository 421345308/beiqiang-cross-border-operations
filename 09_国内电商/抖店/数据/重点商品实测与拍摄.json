    "RETRO0594": {
      "name": "已有成交复古系带款",
      "sample": "按审核页照片找对应独立链接实鞋，黑白/米白/全黑；不能仅凭889货号与M889混拍。先核实鞋、外底轮廓及现有标签",
      "story": [
        {
          "time": "0—3秒",
          "scene": "全身到脚部",
          "action": "同一条日常裤子，站在镜前看鞋的整体比例",
          "voice": "同一条裤子，换个配色是什么感觉？",
          "text": "日常裤装搭配",
          "check": "先核实对应实鞋"
        },
        {
          "time": "3—11秒",
          "scene": "脚踝固定机位",
          "action": "黑白、米白、全黑依次站到同一标记，拍正侧面",
          "voice": "黑白看轮廓，米白看整体，全黑看你喜欢的搭配。",
          "text": "黑白 / 米白 / 全黑",
          "check": "每次换色清楚标注，非同穿一双"
        },
        {
          "time": "11—18秒",
          "scene": "鞋面细节与鞋带",
          "action": "近拍针织纹理，完整调整鞋带",
          "voice": "针织鞋面，系带松紧自己调整。",
          "text": "实鞋细节",
          "check": "不照搬旧图更软更弹升级宣传"
        },
        {
          "time": "18—25秒",
          "scene": "后跟内里俯拍",
          "action": "拍清本次实鞋是常规还是加绒，切尺码标签",
          "voice": "喜欢外观，也要看清内里和尺码。",
          "text": "本镜版本据实标注",
          "check": "没有加绒实鞋先不拍加绒讲解"
        },
        {
          "time": "25—29秒",
          "scene": "同款实鞋全貌",
          "action": "人站定，给鞋一组正侧后镜头",
          "voice": "看看上脚效果，再按自己的脚长选。",
          "text": "选款与合脚都要看",
          "check": "不作真人未体验的长时脚感保证"
        }
      ],
      "selection": [
        {
          "time": "0—8秒",
          "scene": "标签+全鞋三视角",
          "action": "先拍鞋码标签、鞋底及外观，与本页核对",
          "voice": "先确认就是这一款，外观像也不能混用尺码。",
          "text": "款式身份先核",
          "check": "此链接尚未证实与M889同楦"
        },
        {
          "time": "8—18秒",
          "scene": "尺子同框",
          "action": "按本款逐版本量鞋垫长宽，注明颜色批次",
          "voice": "尺码和版本分别记，不借用别款的结果。",
          "text": "逐款实测",
          "check": "不能凭货号889合并"
        },
        {
          "time": "18—30秒",
          "scene": "上脚正侧后",
          "action": "记录试穿人匿名编号、脚长、袜厚及脚背感受",
          "voice": "试穿看前掌、脚背、后跟，记录当下感受。",
          "text": "本人当下试穿",
          "check": "不说所有人都合脚"
        },
        {
          "time": "30—38秒",
          "scene": "表格收尾",
          "action": "结果填表，鞋与标签同框",
          "voice": "资料齐了，再把本款选码页补完整。",
          "text": "本款尺码结果待回填",
          "check": "无实鞋无法拍摄时明确待补"
        }
      ],
