    "A1689": {
      "name": "针织低帮套脚款",
      "sample": "黑白常规、黑白加绒，同尺码并排；全黑补外观与版本照",
      "story": [
        {
          "time": "0—3秒",
          "scene": "同色两双俯拍",
          "action": "两双鞋正面摆齐，手指分别指内里",
          "voice": "看着像同一双，下单先分清常规和加绒。",
          "text": "先选内里，再选颜色",
          "check": "必须同款同色两版本"
        },
        {
          "time": "3—9秒",
          "scene": "鞋口近景",
          "action": "分别撑开鞋口，慢慢转到内里",
          "voice": "这边常规，这边加绒，内里直接给你看。",
          "text": "常规 / 加绒实物对照",
          "check": "标签与版本实物对应"
        },
        {
          "time": "9—15秒",
          "scene": "玄关侧面",
          "action": "真人完整穿鞋，手整理后跟",
          "voice": "不系鞋带，穿上后把鞋口整理好。",
          "text": "套脚免系带",
          "check": "不演一踩即入"
        },
        {
          "time": "15—23秒",
          "scene": "脚踝机位",
          "action": "休闲裤站姿、短距离来回走，展示黑白轮廓",
          "voice": "日常下楼、出门，配自己常穿的裤子看看。",
          "text": "日常穿搭参考",
          "check": "不把模特感受说成人人舒适"
        },
        {
          "time": "23—28秒",
          "scene": "同色两版本回到桌面",
          "action": "手指常规、加绒标签与尺码",
          "voice": "脚背高、厚袜习惯，先把脚长和穿袜情况告诉客服。",
          "text": "版本不同，选码一起看",
          "check": "不全店统一加一码"
        }
      ],
      "selection": [
        {
          "time": "0—6秒",
          "scene": "俯拍",
          "action": "写本款、尺码、版本在卡片上",
          "voice": "先把款式和版本写清，别把两张尺码表混用。",
          "text": "同款、同码、不同内里",
          "check": "镜头有原标签"
        },
        {
          "time": "6—17秒",
          "scene": "鞋垫/鞋口特写",
          "action": "同码两版本分别量鞋垫长宽；拍鞋口自然状态",
          "voice": "同码常规和加绒分别测，不凭外观推脚感。",
          "text": "分版本记录",
          "check": "鞋口不可拉到极限作适配范围"
        },
        {
          "time": "17—29秒",
          "scene": "侧前后上脚",
          "action": "同一人同袜试两版，各站立、走10步并记录",
          "voice": "重点看脚背压不压、前掌紧不紧、后跟是否跟脚。",
          "text": "脚背 / 前掌 / 后跟",
          "check": "量脚信息先留档"
        },
        {
          "time": "29—36秒",
          "scene": "表格与实鞋",
          "action": "拍清结果空位填写过程",
          "voice": "有实际测量和试穿，再给具体选码建议。",
          "text": "按本款实测补尺码",
          "check": "不提前口播偏大偏小"
        }
      ],
