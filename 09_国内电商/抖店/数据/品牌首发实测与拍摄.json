    "ZX9002": {
      "name": "男士加绒套脚款",
      "sample": "深灰黑加绒实鞋；优先41或42码；大码另拿46、47实鞋展示，不用小码代拍",
      "story": [
        {
          "time": "0—3秒",
          "scene": "玄关低机位，裤脚与鞋完整入镜",
          "action": "人拿钥匙准备出门，把鞋放在脚边",
          "voice": "秋冬出门，想少一道系鞋带的步骤？",
          "text": "加绒套脚 · 日常出门",
          "check": "不演免弯腰；普通套脚可用手"
        },
        {
          "time": "3—9秒",
          "scene": "侧前方中近景，连续实拍",
          "action": "手扶后跟提环、脚伸入、整理鞋口，动作完整",
          "voice": "这双是套脚的，穿好后把后跟整理到位。",
          "text": "看清真实穿鞋过程",
          "check": "不剪成无需用手，不放别款"
        },
        {
          "time": "9—15秒",
          "scene": "鞋口俯拍特写",
          "action": "手轻拉鞋口，拍清真实内里和织物纹理",
          "voice": "选冬款，先看清加绒内里，再看鞋口。",
          "text": "加绒内里实拍",
          "check": "目前资料缺内里近照，补拍这一镜"
        },
        {
          "time": "15—23秒",
          "scene": "固定侧面，机位在脚踝高度",
          "action": "同一人平地走近走远，再站定展示裤脚比例",
          "voice": "配日常休闲裤，先看自己喜欢的鞋型。",
          "text": "同款实鞋上脚",
          "check": "不跑跳、泼水或宣称久走不累"
        },
        {
          "time": "23—28秒",
          "scene": "俯拍尺码标签和鞋盒，同鞋收尾",
          "action": "将本款尺码标签拍清，46/47并排另拍",
          "voice": "雷丹森羊，加绒大码怎么选，先对脚长和袜厚。",
          "text": "雷丹森羊｜38—47码，按本款选码",
          "check": "尺码范围与在售一致，不能只说标准码都合脚"
        }
      ],
      "selection": [
        {
          "time": "0—7秒",
          "scene": "俯拍测脚",
          "action": "站立脚跟贴墙，两脚分别量到最长脚趾",
          "voice": "先量两只脚，记较长的一只；单位记毫米。",
          "text": "左右脚分别测",
          "check": "尺子0位与脚跟线同框"
        },
        {
          "time": "7—17秒",
          "scene": "鞋内与鞋垫近景",
          "action": "能取出的鞋垫平铺量长与前掌宽；不可取则说明",
          "voice": "鞋垫能取就平放测，不能取不要硬拆。",
          "text": "鞋垫长≠有效鞋内长",
          "check": "无量具不报鞋内长"
        },
        {
          "time": "17—30秒",
          "scene": "正侧后脚部",
          "action": "同人薄袜、常穿厚袜分别试穿，记录脚背、前掌、后跟",
          "voice": "加绒加厚袜后，脚背和前掌感受要分开看。",
          "text": "薄袜/厚袜分开记录",
          "check": "只说本人当下感受"
        },
        {
          "time": "30—38秒",
          "scene": "46/47标签与量尺",
          "action": "两码分别编号测量并留底",
